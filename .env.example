# Session & Security Configuration
SESSION_SECRET="campus_lost_found_secure_session_key_2026"
ALLOW_ANY_EMAIL_DOMAIN="false"
ALLOWED_COLLEGE_DOMAINS="campus.edu,university.edu,edu.in,ac.in"
